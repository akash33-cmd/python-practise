def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False
    return True


def factorial(n):
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result


while True:
    print("\n1. Check prime")
    print("2. Factorial")
    print("3. Reverse a number")
    print("4. Check palindrome")
    print("5. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        n = int(input("Enter a number: "))
        print("Prime" if is_prime(n) else "Not prime")
    elif choice == 2:
        n = int(input("Enter a number: "))
        print("Factorial:", factorial(n))
    elif choice == 3:
        n = input("Enter a number: ")
        print("Reversed:", n[::-1])
    elif choice == 4:
        n = input("Enter a number: ")
        print("Palindrome" if n == n[::-1] else "Not a palindrome")
    elif choice == 5:
        print("Goodbye")
        break
    else:
        print("Invalid choice")
